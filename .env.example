# =============================================================
# 接力教育智慧云平台 - 环境变量配置
# Jieli Education Smart Cloud Platform
# =============================================================
# 复制此文件为 .env 并修改为实际值:
#   cp .env.example .env
# =============================================================

# ---- 应用配置 ----
APP_NAME=接力教育智慧云平台
APP_ENV=development                    # development | staging | production
APP_DEBUG=true                         # 生产环境务必设为 false
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- 数据库 (MySQL 8.0, 异步驱动 aiomysql) ----
DATABASE_URL=mysql+aiomysql://root:rootpass@localhost:3306/jieli_edu

# ---- Redis 7 (缓存 / 会话 / 分布式锁) ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT 认证 ----
JWT_SECRET_KEY=change-this-to-a-secure-random-string   # 生产环境必须替换为强随机密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ---- 文件存储 ----
STORAGE_TYPE=local                     # local | s3
STORAGE_PATH=./uploads                 # STORAGE_TYPE=local 时的存储目录

# ---- Celery 任务队列 (考试状态流转 / 批量任务) ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- S3 存储 (可选, 仅 STORAGE_TYPE=s3 时需要) ----
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET_NAME=jieli-edu-resources
# S3_REGION=ap-southeast-1

# 数据库
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/jieli_edu

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT 认证
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# 文件存储
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# 应用
APP_NAME=接力教育智慧云平台
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

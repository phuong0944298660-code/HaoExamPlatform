async def check_kicked_middleware(request: Request, call_next):
    """每次请求检查会话是否被踢出"""
    token = request.headers.get("Authorization", "").replace("Bearer ", "")
    
    if token:
        # 检查是否被踢出
        kicked_info = await redis.get(f"kicked_session:{token}")
        if kicked_info:
            data = json.loads(kicked_info)
            return JSONResponse(
                status_code=401,
                content={
                    "code": 1001,
                    "message": "会话已被登出",
                    "detail": {
                        "reason": data.get("reason"),
                        "new_device": data.get("new_device"),
                        "kicked_at": data.get("kicked_at")
                    }
                }
            )
    
    response = await call_next(request)
    return response



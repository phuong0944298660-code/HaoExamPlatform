```python
async def submit_exam(exam_id: int, account_id: int, force: bool = False, idempotency_key: str = None):
    """
    提交试卷（带分布式锁和幂等性保护）
    【已修复】P0-004 提交并发竞态条件：使用Redis分布式锁防止重复提交
    【已修复】P0-011 幂等性设计：支持Idempotency-Key防止重复处理
    """
    lock_key = f"exam:submit:lock:{exam_id}:{account_id}"
    
    # 1. 尝试获取分布式锁（10秒过期，防止死锁）
    lock_acquired = await redis.set(lock_key, "1", nx=True, ex=10)
    if not lock_acquired:
        return {"status": "submitting", "message": "正在提交中，请稍候..."}
    
    try:
        # 2. 幂等性检查（如果提供了幂等key）
        if idempotency_key:
            cache_key = f"exam:submit:result:{idempotency_key}"
            cached_result = await redis.get(cache_key)
            if cached_result:
                return json.loads(cached_result)
        
        # 3. 使用数据库事务和行级锁
        async with db.begin():
            # 使用FOR UPDATE锁定记录，防止并发修改
            assignment = await db.execute(
                select(StudentExamAssignment)
                .where(
                    StudentExamAssignment.exam_id == exam_id,
                    StudentExamAssignment.account_id == account_id
                )
                .with_for_update()
            )
            assignment = assignment.scalar_one_or_none()
            
            if not assignment:
                raise HTTPException(404, "未找到考试记录")
            
            if assignment.status == "submitted":
                raise HTTPException(400, "已提交，不能重复提交")
            
            # 4. 读取Redis中的答题记录
            progress_key = f"exam:progress:{exam_id}:{account_id}"
            progress = await redis.get(progress_key)
            answers = json.loads(progress)["answers"] if progress else {}
            
            # 5. 获取考试快照中的题目
            exam = await db.get(Exam, exam_id)
            paper_snapshot = exam.paper_snapshot
            assigned_paper = next(
                p for p in paper_snapshot["papers"] 
                if p["paper_id"] == assignment.assigned_paper_id
            )
            questions = assigned_paper["questions"]
            
            # 6. 非强制提交时，检测主观题是否上传
            if not force:
                subjective_questions = [q for q in questions if q["question_type"] == "subjective"]
                unuploaded = []
                for q in subjective_questions:
                    q_id = str(q["question_id"])
                    if q_id not in answers or not answers[q_id].get("uploaded_files"):
                        unuploaded.append(q["question_id"])
                
                if unuploaded:
                    return {
                        "can_submit": False,
                        "reason": "subjective_not_uploaded",
                        "unuploaded_questions": unuploaded
                    }
            
            # 7. 客观题自动评分
            objective_score = 0.0
            for q in questions:
                if q["question_type"] in ["single_choice", "multi_choice", "judgment"]:
                    q_id = str(q["question_id"])
                    student_answer = answers.get(q_id, {}).get("answer", "")
                    
                    if q["question_type"] == "multi_choice":
                        score = calculate_multi_choice_score(
                            student_answer,
                            q["correct_answer"],
                            q["scoring_rules"]
                        )
                    else:
                        score = q["score"] if student_answer == q["correct_answer"] else 0
                    
                    objective_score += score
                    answers[q_id]["score"] = score
            
            # 8. 保存提交记录
            assignment.status = "submitted"
            assignment.submitted_at = datetime.utcnow()
            assignment.answers_snapshot = answers
            assignment.objective_score = objective_score
            assignment.submission_ip = request.client.host
            
            # 9. 记录审计日志
            await create_audit_log(
                action_type="exam_submit",
                resource_type="exam_assignment",
                resource_id=assignment.id,
                old_values={"status": "in_progress"},
                new_values={"status": "submitted", "objective_score": objective_score},
                operator_id=account_id
            )
        
        # 事务提交后清理Redis
        await redis.delete(progress_key)
        
        # 缓存提交结果（5分钟，用于幂等性）
        result = {
            "status": "submitted",
            "submitted_at": assignment.submitted_at.isoformat(),
            "objective_score": objective_score
        }
        if idempotency_key:
            await redis.setex(f"exam:submit:result:{idempotency_key}", 300, json.dumps(result))
        
        return result
        
    finally:
        # 释放分布式锁
        await redis.delete(lock_key)



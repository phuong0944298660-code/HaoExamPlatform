# 登录时多端互踢逻辑
async def login(account: str, password: str, device_info: str):
    # 1. 验证账号密码
    user = await verify_credentials(account, password)
    if not user:
        raise HTTPException(401, "账号或密码错误")
    
    # 2. 生成新会话token
    new_token = generate_jwt_token(user.id)
    
    # 3. 如果有旧会话，记录被踢出原因
    if user.session_token:
        await redis.setex(
            f"kicked_session:{user.session_token}",
            3600,  # 1小时过期
            json.dumps({
                "reason": "account_logged_in_elsewhere",
                "new_device": device_info,
                "kicked_at": datetime.utcnow().isoformat()
            })
        )
    
    # 4. 更新会话token
    user.session_token = new_token
    user.last_login_at = datetime.utcnow()
    await db.commit()
    
    # 5. 返回token
    return {"token": new_token, "user": user.to_dict()}



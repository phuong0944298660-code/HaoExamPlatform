### 6.9.1 多级缓存架构
```python
class CacheManager:
    """缓存管理器 - 多级缓存"""
    
    def __init__(self):
        self.local_cache = {}  # L1: 本地内存缓存
        self.redis = redis_client  # L2: Redis缓存
        self.db = db  # L3: 数据库
    
    async def get(self, key: str, fetch_func: callable = None, ttl: int = 300) -> any:
        """获取缓存 - 多级读取"""
        # L1: 本地缓存
        if key in self.local_cache:
            value, expire_at = self.local_cache[key]
            if time.time() < expire_at:
                return value
            else:
                del self.local_cache[key]
        
        # L2: Redis缓存
        value = await self.redis.get(key)
        if value:
            result = json.loads(value)
            # 回填L1
            self.local_cache[key] = (result, time.time() + min(ttl, 60))
            return result
        
        # L3: 数据库
        if fetch_func:
            result = await fetch_func()
            await self.set(key, result, ttl)
            return result
        
        return None
    
    async def set(self, key: str, value: any, ttl: int = 300):
        """设置缓存 - 多级写入"""
        # L1
        self.local_cache[key] = (value, time.time() + min(ttl, 60))
        # L2
        await self.redis.setex(key, ttl, json.dumps(value))
    
    async def invalidate(self, key_pattern: str):
        """失效缓存"""
        # 清理L1
        keys_to_remove = [k for k in self.local_cache if key_pattern in k]
        for k in keys_to_remove:
            del self.local_cache[k]
        
        # 清理L2
        keys = await self.redis.keys(key_pattern)
        if keys:
            await self.redis.delete(*keys)


**读取题目时优先使用快照：**
```python
async def get_student_exam_questions(exam_id: int, account_id: int) -> List[dict]:
    """
    获取学生考试题目
    优先从快照读取，确保考试期间题目不变
    """
    exam = await db.get(Exam, exam_id)
    assignment = await db.query(StudentExamAssignment).filter_by(
        exam_id=exam_id, 
        account_id=account_id
    ).first()
    
    if not assignment:
        raise HTTPException(404, "未找到考试记录")
    
    # 从快照读取（关键！不查询套卷实时数据）
    paper_snapshot = next(
        (p for p in exam.paper_snapshot["papers"] 
         if p["paper_id"] == assignment.assigned_paper_id),
        None
    )
    
    if not paper_snapshot:
        raise HTTPException(500, "考试快照丢失")
    
    return paper_snapshot["questions"]

# app/services/account_service.py

def generate_initial_password(identity_no: str) -> str:
    """
    生成初始密码
    - 考试账号：身份证后8位
    - 练习账号：默认123456
    """
    if identity_no and len(identity_no) >= 8:
        return identity_no[-8:]
    return "123456"

async def batch_generate_exam_accounts(students: list, grade_group: str):
    """批量生成考试账号"""
    accounts = []
    for student in students:
        identity_no = student["identity_no"]
        initial_password = generate_initial_password(identity_no)
        
        accounts.append({
            "identity_no": identity_no,
            "hashed_password": hash_password(initial_password),
            "name": student["name"],
            "school": student["school"],
            "grade_group": grade_group,
            "account_type": AccountType.EXAM,
            "initial_password": initial_password  # 记录初始密码（明文用于导出）
        })
    
    return accounts
```

**注意事项**: 需评估隐私合规性，建议在导出密码表时添加安全提示。


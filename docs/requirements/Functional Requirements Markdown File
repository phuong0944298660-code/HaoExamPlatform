    async with db.begin():
        # 1. PENDING -> OPEN（到达开始时间）
        pending_result = await db.execute(
            select(Exam).where(
                Exam.status == ExamStatus.PENDING,
                Exam.start_time <= now
            )
        )
        pending_exams = pending_result.scalars().all()
        
        for exam in pending_exams:
            exam.status = ExamStatus.OPEN
            logger.info(f"考试 {exam.id} 状态转换: PENDING -> OPEN")
            # 通过WebSocket通知所有已登录学生考试开始
            await notify_students_exam_started(exam.id)
        
        # 2. OPEN -> FINISHED（到达结束时间）
        open_result = await db.execute(
            select(Exam).where(
                Exam.status == ExamStatus.OPEN,
                Exam.end_time <= now
            )
        )
        open_exams = open_result.scalars().all()
        
        for exam in open_exams:
            logger.info(f"考试 {exam.id} 结束时间到达，开始自动提交")
            # 触发自动提交任务（异步执行，不阻塞状态转换）
            auto_submit_exam_task.delay(exam.id)
            # 状态将在自动提交完成后更新
    
    logger.info(f"考试状态检查完成: {len(pending_exams)} 个开始, {len(open_exams)} 个结束")



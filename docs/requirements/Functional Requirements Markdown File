## 6.4 考试状态转换边界处理【已修复 P2-002】

### 6.4.1 状态转换校验
```python
class ExamStateMachine:
    """考试状态机 - 确保状态转换的合法性"""
    
    # 定义合法的状态转换
    VALID_TRANSITIONS = {
        "draft": ["pending"],           # 草稿只能发布为待开始
        "pending": ["open", "closed"],  # 未开始可以变为进行中或手动关闭
        "open": ["finished", "closed"], # 进行中可以结束或手动关闭
        "closed": [],                    # 已关闭为终态
        "finished": []                   # 已完成为终态
    }
    
    @classmethod
    def can_transition(cls, from_status: str, to_status: str) -> bool:
        return to_status in cls.VALID_TRANSITIONS.get(from_status, [])
    
    @classmethod
    async def transition(cls, exam_id: int, to_status: str, force: bool = False):
        """执行状态转换"""
        async with db.transaction():
            exam = await db.query(Exam).filter_by(id=exam_id).with_for_update().first()
            
            if not exam:
                raise HTTPException(404, "考试不存在")
            
            # 检查转换是否合法
            if not cls.can_transition(exam.status, to_status):
                raise HTTPException(400, 
                    f"非法状态转换: {exam.status} -> {to_status}")
            
            # 执行业务逻辑检查
            if to_status == "open" and exam.start_time > datetime.utcnow():
                if not force:
                    raise HTTPException(400, "考试开始时间未到")
            
            # 执行转换
            old_status = exam.status
            exam.status = to_status
            exam.status_changed_at = datetime.utcnow()
            
            # 记录状态变更日志
            await ExamStatusLog.create(
                exam_id=exam_id,
                from_status=old_status,
                to_status=to_status,
                changed_by=current_user.id,
                changed_at=datetime.utcnow()
            )
            
            await db.commit()
            return exam

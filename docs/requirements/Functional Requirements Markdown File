**@core-logic - 多选题评分算法**:
```python
def calculate_multi_choice_score(
    student_answer: str,      # 学生答案如 "AB"
    correct_answer: str,      # 正确答案如 "ABD"
    scoring_rules: dict
) -> float:
    """
    多选题评分规则（已修复：支持多种计分模式）
    - 答案完全正确：得满分
    - 答案少选但全对：根据partial_mode计算得分
    - 答案多选/错选：得0分或wrong_score

    支持三种partial_mode:
    - fixed: 固定分值模式（默认）
    - per_option: 按选项计分模式
    - proportional: 按比例计分模式
    """
    student_set = set(student_answer) if student_answer else set()
    correct_set = set(correct_answer)

    full_score = scoring_rules.get("full_score", 2.0)
    partial_mode = scoring_rules.get("partial_mode", "fixed")
    wrong_score = scoring_rules.get("wrong_score", 0.0)

    # 完全正确
    if student_set == correct_set:
        return full_score

    # 判断是否全对但少选（学生选的都在正确答案中，且至少选了一个）
    if student_set.issubset(correct_set) and len(student_set) > 0:
        if partial_mode == "fixed":
            # 固定分值模式：无论少选几个都得相同的部分分
            return scoring_rules.get("partial_score", 1.0)
        elif partial_mode == "per_option":
            # 按选项计分模式：每选对1个选项得固定分值
            per_option_score = full_score / len(correct_set)
            return round(len(student_set) * per_option_score, 2)
        elif partial_mode == "proportional":
            # 按比例计分模式：按选对比例给分
            ratio = len(student_set) / len(correct_set)
            return round(full_score * ratio, 2)

    # 多选或错选
    return wrong_score



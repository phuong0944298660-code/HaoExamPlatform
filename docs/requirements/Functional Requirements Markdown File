async def update_paper(paper_id: int, updates: dict, force: bool = False):
    paper = await db.get(ExamPaper, paper_id)
    
    if paper.status == PaperStatus.PUBLISHED and not force:
        # 检查引用情况
        exam_count = await db.query(Exam).filter(
            Exam.paper_ids.contains([paper_id])
        ).count()
        
        if exam_count > 0:
            raise WarningException(
                f"此套卷已被{exam_count}个考试引用。\n"
                f"修改后：\n"
                f"- 已存在的考试不受影响（使用快照）\n"
                f"- 新建的考试将使用新版本\n"
                f"确认要继续修改吗？",
                require_confirm=True
            )
    
    # 执行更新
    for key, value in updates.items():
        setattr(paper, key, value)
    
    paper.version += 1  # 版本号+1
    paper.updated_at = datetime.utcnow()
    await db.commit()

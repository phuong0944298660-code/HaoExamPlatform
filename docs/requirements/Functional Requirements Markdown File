// 考生状态标签 - 统一倒计时格式【已修复 P2-002】
const StudentStatusTag: React.FC<{ status: string; remainingTime?: number }> = ({
  status, remainingTime
}) => {
  const statusMap = {
    not_logged_in: { color: 'default', text: '未登录', icon: <MinusCircleOutlined /> },
    in_progress: { color: 'processing', text: '答题中', icon: <EditOutlined /> },
    submitted: { color: 'success', text: '已提交', icon: <CheckCircleOutlined /> },
    timeout: { color: 'error', text: '已超时', icon: <ClockCircleOutlined /> },
    abnormal: { color: 'warning', text: '异常', icon: <WarningOutlined /> }
  };

  const config = statusMap[status];

  // 统一倒计时格式工具函数
  const formatCountdown = (seconds: number): string => {
    if (seconds <= 0) return '已结束';
    if (seconds > 3600) {
      const hours = Math.floor(seconds / 3600);
      const mins = Math.floor((seconds % 3600) / 60);
      return `剩余 ${hours}小时${mins}分`;
    } else if (seconds > 600) {
      // 10分钟以上，显示分钟
      return `剩余 ${Math.floor(seconds / 60)}分钟`;
    } else {
      // 10分钟以内，显示分:秒格式
      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      return `剩余 ${mins}:${String(secs).padStart(2, '0')}`;  // 如: "剩余 9:45"
    }
  };

  return (
    <Tag icon={config.icon} color={config.color}>
      {config.text}
      {status === 'in_progress' && remainingTime !== undefined && (
        <span
          className={`remaining-time ${remainingTime < 600 ? 'urgent' : ''}`}
          title={formatCountdown(remainingTime)}
        >
          {formatCountdown(remainingTime)}
        </span>
      )}
    </Tag>
  );
};

// 考试页面倒计时组件 - 使用统一格式
const ExamCountdown: React.FC<{ endTime: string; startTime: string }> = ({ endTime, startTime }) => {
  const [remainingSeconds, setRemainingSeconds] = useState(() => {
    const end = new Date(endTime).getTime();
    const now = Date.now();
    return Math.max(0, Math.floor((end - now) / 1000));
  });

  useEffect(() => {
    const timer = setInterval(() => {
      const end = new Date(endTime).getTime();
      const now = Date.now();
      const remaining = Math.max(0, Math.floor((end - now) / 1000));
      setRemainingSeconds(remaining);
    }, 1000);
    return () => clearInterval(timer);
  }, [endTime]);

  const formatCountdown = (seconds: number): { text: string; isUrgent: boolean } => {
    if (seconds <= 0) return { text: '已结束', isUrgent: true };
    if (seconds > 3600) {
      const hours = Math.floor(seconds / 3600);
      const mins = Math.floor((seconds % 3600) / 60);
      return { text: `剩余 ${hours}小时${mins}分`, isUrgent: false };
    } else if (seconds > 600) {
      return { text: `剩余 ${Math.floor(seconds / 60)}分钟`, isUrgent: false };
    } else {
      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      return { text: `剩余 ${mins}:${String(secs).padStart(2, '0')}`, isUrgent: true };
    }
  };

  const { text, isUrgent } = formatCountdown(remainingSeconds);

  return (
    <div className={`countdown-display ${isUrgent ? 'urgent' : ''}`}>
      {text}
      {isUrgent && <BellOutlined className="urgent-icon" />}
    </div>
  );
};

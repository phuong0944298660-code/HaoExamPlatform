```python
import hashlib
import json

# 快照版本定义（用于向后兼容）
SNAPSHOT_VERSION = 2  # 当前快照结构版本

async def publish_exam(exam_id: int):
    """
    发布考试，创建套卷快照
    【已修复】P0-009 快照版本控制和完整性校验
    """
    async with db.begin():
        exam = await db.get(Exam, exam_id)
        if not exam:
            raise HTTPException(404, "考试不存在")
        
        if exam.status != ExamStatus.DRAFT:
            raise HTTPException(400, "只有草稿状态考试可以发布")
        
        # 1. 获取所有关联套卷
        papers_result = await db.execute(
            select(ExamPaper).where(ExamPaper.id.in_(exam.paper_ids))
        )
        papers = papers_result.scalars().all()
        
        # 2. 构建快照（带版本信息）
        snapshot = {
            "version": SNAPSHOT_VERSION,  # 【已修复】添加版本号
            "created_at": datetime.utcnow().isoformat(),
            "created_by": exam.created_by,
            "papers": []
        }
        
        for paper in papers:
            paper_snapshot = {
                "paper_id": paper.id,
                "paper_name": paper.name,
                "paper_version": paper.version if hasattr(paper, 'version') else 1,
                "questions": []
            }
            
            # 获取套卷所有题目完整内容
            for config in paper.questions_config:
                question = await db.get(Question, config["question_id"])
                if question and not question.is_deleted:
                    paper_snapshot["questions"].append({
                        "question_id": question.id,
                        "content": question.content,
                        "images": question.images,
                        "question_type": question.question_type.value,
                        "options": question.options,
                        "correct_answer": question.correct_answer,
                        "score": config.get("score", question.default_score),
                        "scoring_rules": question.scoring_rules,
                        "answer_analysis": question.answer_analysis
                    })
            
            snapshot["papers"].append(paper_snapshot)
        
        # 3. 计算快照哈希（用于完整性校验）
        snapshot_json = json.dumps(snapshot, sort_keys=True, ensure_ascii=False)
        snapshot_hash = hashlib.sha256(snapshot_json.encode()).hexdigest()
        
        # 4. 保存快照（带版本和哈希）
        exam.paper_snapshot = snapshot
        exam.paper_snapshot_version = SNAPSHOT_VERSION  # 【已修复】
        exam.paper_snapshot_hash = snapshot_hash  # 【已修复】
        exam.status = ExamStatus.PENDING
        exam.published_at = datetime.utcnow()
        
        # 5. 创建学生考试关联记录（分配A/B卷）
        for i, student in enumerate(exam.student_list):
            # 轮流分配套卷（A/B卷轮流）
            assigned_paper_id = exam.paper_ids[i % len(exam.paper_ids)]
            
            assignment = StudentExamAssignment(
                exam_id=exam.id,
                account_id=student["account_id"],
                assigned_paper_id=assigned_paper_id
            )
            db.add(assignment)
    
    logger.info(f"考试 {exam_id} 发布成功，快照版本 {SNAPSHOT_VERSION}，哈希 {snapshot_hash[:16]}...")
    return {
        "message": "考试发布成功，快照已创建",
        "snapshot_version": SNAPSHOT_VERSION,
        "snapshot_hash": snapshot_hash[:16] + "..."
    }


# 【已修复】P0-009 快照兼容性读取
async def get_exam_snapshot(exam_id: int) -> dict:
    """
    读取考试快照（带版本兼容性处理）
    【已修复】P0-009 快照版本兼容性处理
    """
    exam = await db.get(Exam, exam_id)
    if not exam or not exam.paper_snapshot:
        raise HTTPException(404, "考试快照不存在")
    
    snapshot = exam.paper_snapshot
    snapshot_version = exam.paper_snapshot_version or 1
    
    # 版本兼容性处理
    if snapshot_version == 1:
        # V1版本快照没有version字段，需要适配
        logger.warning(f"考试 {exam_id} 使用V1快照，建议重新发布考试")
        snapshot = migrate_snapshot_v1_to_v2(snapshot)
    elif snapshot_version > SNAPSHOT_VERSION:
        # 快照版本高于系统支持的版本
        raise HTTPException(500, 
            f"快照版本 {snapshot_version} 高于系统支持的版本 {SNAPSHOT_VERSION}，"
            f"请升级系统或使用旧版本查看"
        )
    
    # 完整性校验
    if exam.paper_snapshot_hash:
        current_hash = hashlib.sha256(
            json.dumps(snapshot, sort_keys=True, ensure_ascii=False).encode()
        ).hexdigest()
        if current_hash != exam.paper_snapshot_hash:
            logger.error(f"考试 {exam_id} 快照完整性校验失败！")
            raise HTTPException(500, "考试快照数据损坏，请联系管理员")
    
    return snapshot


def migrate_snapshot_v1_to_v2(snapshot_v1: dict) -> dict:
    """将V1快照迁移到V2格式"""
    snapshot_v2 = {
        "version": 2,
        "created_at": snapshot_v1.get("created_at", datetime.utcnow().isoformat()),
        "created_by": None,
        "papers": []
    }
    
    for paper in snapshot_v1.get("papers", []):
        paper_v2 = {
            "paper_id": paper.get("paper_id"),
            "paper_name": paper.get("paper_name"),
            "paper_version": 1,
            "questions": paper.get("questions", [])
        }
        snapshot_v2["papers"].append(paper_v2)
    
    return snapshot_v2



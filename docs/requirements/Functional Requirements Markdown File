## 6.5 WebSocket连接稳定性保障【已修复 P2-003 / P3-003】

### 6.5.1 WebSocket连接管理
```python
class ExamWebSocketManager:
    """考试WebSocket连接管理器"""
    
    def __init__(self):
        self.active_connections: Dict[int, WebSocket] = {}
        self.heartbeat_interval = 30  # 30秒心跳
        self.max_reconnect_attempts = 5
    
    async def connect(self, websocket: WebSocket, account_id: int, exam_id: int):
        await websocket.accept()
        
        # 检查是否已有连接（多端登录）
        if account_id in self.active_connections:
            old_ws = self.active_connections[account_id]
            await self.send_personal_message(account_id, {
                "type": "connection_replaced",
                "message": "您的账号在其他设备登录"
            })
            await old_ws.close()
        
        self.active_connections[account_id] = websocket
        
        # 启动心跳检测
        asyncio.create_task(self.heartbeat_checker(account_id, websocket))
        
        # 发送连接成功消息
        await self.send_personal_message(account_id, {
            "type": "connected",
            "exam_id": exam_id,
            "server_time": datetime.utcnow().isoformat()
        })
    
    async def heartbeat_checker(self, account_id: int, websocket: WebSocket):
        """心跳检测 - 自动重连机制"""
        missed_heartbeats = 0
        max_missed = 3
        
        while account_id in self.active_connections:
            try:
                # 发送ping
                await websocket.send_json({"type": "ping", "timestamp": time.time()})
                
                # 等待pong（设置超时）
                response = await asyncio.wait_for(
                    websocket.receive_json(),
                    timeout=10
                )
                
                if response.get("type") == "pong":
                    missed_heartbeats = 0
                else:
                    missed_heartbeats += 1
                    
            except asyncio.TimeoutError:
                missed_heartbeats += 1
                logger.warning(f"账号 {account_id} 心跳超时 ({missed_heartbeats}/{max_missed})")
                
            except Exception as e:
                logger.error(f"心跳检测异常: {e}")
                break
            
            # 连续3次心跳失败，断开连接
            if missed_heartbeats >= max_missed:
                logger.warning(f"账号 {account_id} 心跳失败，断开连接")
                await self.disconnect(account_id, "heartbeat_timeout")
                break
            
            await asyncio.sleep(self.heartbeat_interval)
    
    async def disconnect(self, account_id: int, reason: str = "client_disconnect"):
        """断开连接"""
        if account_id in self.active_connections:
            websocket = self.active_connections[account_id]
            try:
                await websocket.close()
            except:
                pass
            del self.active_connections[account_id]
            
            logger.info(f"账号 {account_id} 断开连接，原因: {reason}")
```

### 6.5.2 降级机制
```python
class ExamConnectionManager:
    """连接管理 - 支持WebSocket降级到HTTP轮询"""
    
    def __init__(self):
        self.ws_manager = ExamWebSocketManager()
        self.polling_clients: Dict[int, datetime] = {}  # 轮询客户端
    
    async def get_connection_type(self, account_id: int) -> str:
        """获取当前连接类型"""
        if account_id in self.ws_manager.active_connections:
            return "websocket"
        if account_id in self.polling_clients:
            return "polling"
        return "disconnected"
    
    async def send_message(self, account_id: int, message: dict) -> bool:
        """发送消息 - 自动选择可用通道"""
        connection_type = await self.get_connection_type(account_id)
        
        if connection_type == "websocket":
            try:
                await self.ws_manager.send_personal_message(account_id, message)
                return True
            except Exception as e:
                logger.warning(f"WebSocket发送失败，降级到轮询: {e}")
                # 标记为轮询客户端
                self.polling_clients[account_id] = datetime.utcnow()
        
        if connection_type in ["polling", "websocket"]:
            # 将消息存入Redis，供轮询获取
            await self.store_message_for_polling(account_id, message)
            return True
        
        return False
    
    async def store_message_for_polling(self, account_id: int, message: dict):
        """为轮询客户端存储消息"""
        key = f"exam:messages:{account_id}"
        await redis.lpush(key, json.dumps(message))
        await redis.ltrim(key, 0, 99)  # 保留最近100条
        await redis.expire(key, 3600)  # 1小时过期

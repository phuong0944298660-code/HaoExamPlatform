async def save_answer(
    exam_id: int, 
    account_id: int, 
    question_id: int, 
    answer: str,
    uploaded_files: list = None
):
    """保存答题记录到Redis"""
    cache_key = f"exam:progress:{exam_id}:{account_id}"
    
    # 读取现有记录
    progress = await redis.get(cache_key)
    if progress:
        progress = json.loads(progress)
    else:
        progress = {"answers": {}}
    
    # 更新答案
    progress["answers"][str(question_id)] = {
        "answer": answer,
        "uploaded_files": uploaded_files or [],
        "answered_at": datetime.utcnow().isoformat()
    }
    progress["last_saved_at"] = datetime.utcnow().isoformat()
    
    # 保存到Redis（过期时间 = 考试结束时间 + 1小时）
    exam = await db.get(Exam, exam_id)
    ttl = int((exam.end_time + timedelta(hours=1) - datetime.utcnow()).total_seconds())
    await redis.setex(cache_key, ttl, json.dumps(progress))
    
    # WebSocket通知前端保存成功
    await ws_manager.send_personal_message(
        account_id,
        {"type": "answer_saved", "question_id": question_id}
    )
    
    return {"status": "saved"}

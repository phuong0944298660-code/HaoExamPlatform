        """获取资源预览URL（带防盗链签名）"""
        resource = await db.get(Resource, resource_id)
        if not resource:
            raise HTTPException(404, "资源不存在")
        
        # 权限检查
        if user.role not in resource.allowed_roles:
            raise HTTPException(403, "无权限访问此资源")
        
        # 生成带签名的预览URL（限时有效）
        preview_url = await self._generate_preview_url(
            resource.file_url,
            expire_seconds=3600,
            watermark=user.name  # 添加用户水印
        )
        
        return preview_url
    
    async def download_resource(self, resource_id: int, user: User):

async def batch_import_questions(questions: List[dict], batch_size: int = 100) -> dict:
    """批量导入题目 - 使用批量插入优化"""
    results = {"success": 0, "failed": 0, "errors": []}
    
    # 分批次处理
    for i in range(0, len(questions), batch_size):
        batch = questions[i:i + batch_size]
        
        try:
            async with db.begin():
                # 使用批量插入
                await db.execute(
                    insert(Question).values(batch)
                )
                results["success"] += len(batch)
                
        except Exception as e:
            # 批次失败，逐条重试
            for question in batch:
                try:
                    async with db.begin():
                        await db.execute(insert(Question).values(question))
                        results["success"] += 1
                except Exception as e2:
                    results["failed"] += 1
                    results["errors"].append({
                        "question": question.get("content", "")[:50],
                        "error": str(e2)
                    })
        
        # 每批次完成后更新进度
        await update_import_progress(len(results["success"]) + len(results["failed"]), len(questions))
    
    return results


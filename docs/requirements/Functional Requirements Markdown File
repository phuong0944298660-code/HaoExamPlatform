**详细设计**:

```python
# app/services/grading_import_service.py

class GradingImportService:
    """主观题评分表批量导入服务"""
    
    async def batch_import_from_archive(
        self,
        exam_id: int,
        archive_file: UploadFile,
        current_user: User
    ) -> dict:
        """
        从压缩包批量导入评分表
        
        压缩包结构示例:
        评分表/
        ├── 学生身份证号1/
        │   ├── 裁判1_评分表.jpg
        │   ├── 裁判2_评分表.jpg
        │   └── 裁判3_评分表.jpg
        ├── 学生身份证号2/
        │   ├── 裁判1_评分表.jpg
        │   └── ...
        """
        # 1. 解压压缩包到临时目录
        temp_dir = await self._extract_archive(archive_file)
        
        try:
            # 2. 遍历学生文件夹
            results = {"success": [], "failed": []}
            
            for student_folder in os.listdir(temp_dir):
                folder_path = os.path.join(temp_dir, student_folder)
                if not os.path.isdir(folder_path):
                    continue
                
                # 3. 验证身份证号并获取学生信息
                student = await self._get_student_by_identity(exam_id, student_folder)
                if not student:
                    results["failed"].append({
                        "folder": student_folder,
                        "reason": "未找到对应学生"
                    })
                    continue
                
                # 4. 上传评分表图片
                grading_sheets = []
                for sheet_file in os.listdir(folder_path):
                    file_path = os.path.join(folder_path, sheet_file)
                    
                    # 上传到OSS/存储
                    url = await self._upload_grading_sheet(
                        exam_id=exam_id,
                        account_id=student.id,
                        file_path=file_path,
                        judge_name=sheet_file  # 从文件名提取裁判信息
                    )
                    grading_sheets.append({
                        "judge": sheet_file,
                        "url": url,
                        "uploaded_at": datetime.utcnow().isoformat()
                    })
                
                # 5. 保存评分表关联记录
                await self._save_grading_sheets(student.id, grading_sheets)
                results["success"].append({
                    "student": student.name,
                    "identity_no": student_folder,
                    "sheets_count": len(grading_sheets)
                })
            
            return {
                "code": 200,
                "message": f"导入完成: 成功{len(results['success'])}人, 失败{len(results['failed'])}人",
                "data": results
            }
            
        finally:
            # 清理临时文件
            await self._cleanup_temp_dir(temp_dir)
    
    async def _extract_archive(self, archive_file: UploadFile) -> str:
        """解压压缩包"""
        import zipfile
        import tarfile
        import tempfile
        
        temp_dir = tempfile.mkdtemp()
        file_path = os.path.join(temp_dir, archive_file.filename)
        
        # 保存上传文件
        with open(file_path, "wb") as f:
            content = await archive_file.read()
            f.write(content)
        
        # 解压
        extract_dir = os.path.join(temp_dir, "extracted")
        os.makedirs(extract_dir, exist_ok=True)
        
        if archive_file.filename.endswith('.zip'):
            with zipfile.ZipFile(file_path, 'r') as zip_ref:
                zip_ref.extractall(extract_dir)
        elif archive_file.filename.endswith(('.tar.gz', '.tgz')):
            with tarfile.open(file_path, 'r:gz') as tar_ref:
                tar_ref.extractall(extract_dir)
        elif archive_file.filename.endswith('.rar'):
            # 需要安装 unrar 工具
            import subprocess
            subprocess.run(['unrar', 'x', file_path, extract_dir], check=True)
        
        return extract_dir
```


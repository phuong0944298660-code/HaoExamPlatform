{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Java Backend (Spring Boot)",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["-f", "backend-java/pom.xml", "spring-boot:run"],
      "port": 8082,
      "autoPort": false
    },
    {
      "name": "Frontend (Vite + Vue 3)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "Python Backend (FastAPI)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    }
  ]
}
